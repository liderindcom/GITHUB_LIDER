{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lider.local/portal-fornecedor/schemas/product-commercial-scope.schema.json",
  "title": "Portal Fornecedor - escopo comercial de produtos",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAt", "homologationStatus", "scopeVersion", "accessContext", "page", "rows"],
  "properties": {
    "generatedAt": { "$ref": "common.schema.json#/$defs/isoDateTime" },
    "homologationStatus": { "$ref": "common.schema.json#/$defs/homologationStatus" },
    "scopeVersion": { "type": "string", "minLength": 1 },
    "dataFreshness": { "$ref": "common.schema.json#/$defs/dataFreshness" },
    "accessContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "requestedSupplierCode", "writesToErp"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["fiscal_supplier", "commercial_group", "brand", "distributor"]
        },
        "requestedSupplierCode": { "type": "string", "minLength": 1 },
        "commercialGroupId": { "type": ["string", "null"], "minLength": 1 },
        "brandId": { "type": ["string", "null"], "minLength": 1 },
        "writesToErp": { "const": false }
      }
    },
    "page": { "$ref": "common.schema.json#/$defs/pageMeta" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "description",
          "fiscalSupplierCode",
          "commercialGroupId",
          "brandId",
          "lineCode",
          "lifecycleStatus",
          "stockQtyConsidered",
          "inclusionStatus",
          "inclusionReason",
          "itemRole",
          "supplierRelationship",
          "blockedBranchCount",
          "writesToErp"
        ],
        "properties": {
          "sku": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "fiscalSupplierCode": { "type": "string", "minLength": 1 },
          "fiscalSupplierName": { "type": "string" },
          "commercialGroupId": { "type": ["string", "null"], "minLength": 1 },
          "commercialGroupName": { "type": ["string", "null"] },
          "brandId": { "type": ["string", "null"], "minLength": 1 },
          "brandName": { "type": ["string", "null"] },
          "lineCode": { "type": ["string", "null"] },
          "lineMeaning": { "type": ["string", "null"] },
          "lifecycleStatus": {
            "type": "string",
            "enum": ["active", "out_of_line", "unknown"]
          },
          "stockQtyConsidered": { "type": "number", "minimum": 0 },
          "inclusionStatus": {
            "type": "string",
            "enum": ["included", "excluded", "restricted", "pending_source"]
          },
          "inclusionReason": {
            "type": "string",
            "enum": [
              "active_line",
              "out_of_line_with_stock",
              "out_of_line_without_stock",
              "usage_consumption_excluded",
              "production_input_restricted",
              "finished_good_included",
              "blocked_but_in_line",
              "source_pending"
            ]
          },
          "itemRole": {
            "type": "string",
            "enum": [
              "resale",
              "usage_consumption",
              "production_input",
              "finished_good",
              "internal_unknown"
            ]
          },
          "supplierRelationship": {
            "type": "string",
            "enum": [
              "principal_fiscal",
              "commercial_group_member",
              "distributor_brand",
              "alternative_supplier",
              "manual_exception"
            ]
          },
          "blockedBranchCount": { "type": "integer", "minimum": 0 },
          "sourceEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["productSource", "stockSource", "mappingSource"],
            "properties": {
              "productSource": { "type": "string", "minLength": 1 },
              "stockSource": { "type": "string", "minLength": 1 },
              "mappingSource": { "type": "string", "minLength": 1 },
              "approvalEventId": { "type": ["string", "null"] }
            }
          },
          "writesToErp": { "const": false }
        }
      }
    }
  }
}
