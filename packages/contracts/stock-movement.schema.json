{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lider.local/portal-fornecedor/schemas/stock-movement.schema.json",
  "title": "GET /v1/stock/movements",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAt", "homologationStatus", "supplierId", "window", "page", "rows"],
  "properties": {
    "generatedAt": { "type": "string", "format": "date-time" },
    "homologationStatus": {
      "type": "string",
      "enum": ["candidato", "aguarda_aceite", "restrito", "bloqueado"]
    },
    "supplierId": { "type": "string", "format": "uuid" },
    "window": {
      "type": "object",
      "required": ["from", "to", "maxDays"],
      "properties": {
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" },
        "maxDays": { "type": "integer", "const": 90 }
      }
    },
    "page": {
      "type": "object",
      "required": ["limit", "hasMore"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
        "hasMore": { "type": "boolean" },
        "nextCursor": { "type": ["string", "null"] }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "branchId", "sku", "movedAt", "qty", "movementType"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "branchId": { "type": "string" },
          "sku": { "type": "string" },
          "movedAt": { "type": "string", "format": "date-time" },
          "qty": { "type": "number" },
          "movementType": {
            "type": "string",
            "enum": ["entrada", "saida", "ajuste", "transferencia", "venda", "outro"]
          },
          "documentRef": { "type": ["string", "null"] }
        }
      }
    }
  }
}
