{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lider.local/portal-fornecedor/schemas/operational-flow-projection.schema.json",
  "title": "Operational flow projection by supplier and horizon (candidate, internal buyer only)",
  "description": "Projecao candidata de fluxo operacional por fornecedor e horizonte: vendas realizadas + entradas financeiras previstas - compromissos a pagar agregados. Cada serie exige fonte, corte, regra e permissao; sem qualquer um deles a serie fica SEM BASE FINANCEIRA e nao tem lacuna preenchida. Nao e saldo bancario nem caixa disponivel.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generatedAt",
    "homologationStatus",
    "supplierCode",
    "horizon",
    "internalOnly",
    "financialBasis",
    "reason",
    "series",
    "rows",
    "totals",
    "writesToErp",
    "disclaimer"
  ],
  "properties": {
    "generatedAt": { "type": "string", "format": "date-time" },
    "homologationStatus": {
      "type": "string",
      "enum": ["candidato", "aguarda_aceite", "restrito", "bloqueado"]
    },
    "supplierCode": {
      "type": "string",
      "minLength": 1,
      "description": "Codigo RMS sem digito verificador, igual a fornecedorCodigo dos caches do portal."
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horizonId", "horizonDate", "buckets"],
      "properties": {
        "horizonId": { "type": "string", "minLength": 1 },
        "horizonDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "buckets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["bucketId", "fromDate", "toDate"],
            "properties": {
              "bucketId": { "type": "string", "minLength": 1 },
              "fromDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "toDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        }
      }
    },
    "internalOnly": {
      "type": "boolean",
      "const": true,
      "description": "Exposto apenas para comprador interno autorizado; nunca para fornecedor ou AppCom."
    },
    "financialBasis": {
      "type": "string",
      "enum": ["sem_base_financeira", "base_candidata"]
    },
    "reason": {
      "type": "string",
      "enum": [
        "series_ausente",
        "fonte_ausente",
        "corte_ausente",
        "regra_ausente",
        "permissao_ausente",
        "permissao_negada",
        "base_nao_autorizada",
        "base_candidata"
      ]
    },
    "series": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seriesId",
          "sourceName",
          "sourceCutId",
          "ruleVersion",
          "permission",
          "financialBasis",
          "reason"
        ],
        "properties": {
          "seriesId": {
            "type": "string",
            "enum": ["vendas_realizadas", "entradas_financeiras_previstas", "compromissos_a_pagar"]
          },
          "sourceName": { "type": ["string", "null"] },
          "sourceCutId": { "type": ["string", "null"] },
          "ruleVersion": { "type": ["string", "null"] },
          "permission": { "type": ["string", "null"] },
          "financialBasis": {
            "type": "string",
            "enum": ["sem_base_financeira", "base_candidata"]
          },
          "reason": {
            "type": "string",
            "enum": [
              "series_ausente",
              "fonte_ausente",
              "corte_ausente",
              "regra_ausente",
              "permissao_ausente",
              "permissao_negada",
              "base_nao_autorizada",
              "base_candidata"
            ]
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bucketId",
          "fromDate",
          "toDate",
          "vendasRealizadasAmount",
          "entradasFinanceirasPrevistasAmount",
          "compromissosAPagarAmount",
          "projectedOperationalFlowAmount"
        ],
        "properties": {
          "bucketId": { "type": "string", "minLength": 1 },
          "fromDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "toDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "vendasRealizadasAmount": {
            "type": ["string", "null"],
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "entradasFinanceirasPrevistasAmount": {
            "type": ["string", "null"],
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "compromissosAPagarAmount": {
            "type": ["string", "null"],
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "projectedOperationalFlowAmount": {
            "type": ["string", "null"],
            "pattern": "^-?\\d+\\.\\d{2}$"
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendasRealizadasAmount",
        "entradasFinanceirasPrevistasAmount",
        "compromissosAPagarAmount",
        "projectedOperationalFlowAmount",
        "rowCount"
      ],
      "properties": {
        "vendasRealizadasAmount": {
          "type": ["string", "null"],
          "pattern": "^-?\\d+\\.\\d{2}$"
        },
        "entradasFinanceirasPrevistasAmount": {
          "type": ["string", "null"],
          "pattern": "^-?\\d+\\.\\d{2}$"
        },
        "compromissosAPagarAmount": {
          "type": ["string", "null"],
          "pattern": "^-?\\d+\\.\\d{2}$"
        },
        "projectedOperationalFlowAmount": {
          "type": ["string", "null"],
          "pattern": "^-?\\d+\\.\\d{2}$"
        },
        "rowCount": { "type": "integer", "minimum": 0 }
      }
    },
    "writesToErp": {
      "type": "boolean",
      "const": false,
      "description": "Projecao candidata nao escreve em ERP financeiro."
    },
    "disclaimer": {
      "type": "string",
      "const": "Fluxo operacional projetado por horizonte (vendas realizadas + entradas financeiras previstas - compromissos a pagar). Nao e saldo bancario nem caixa disponivel; sem preencher lacunas quando fonte, corte, regra ou permissao estiver ausente. Interno para comprador autorizado; nunca exposto a fornecedor ou AppCom."
    }
  }
}
