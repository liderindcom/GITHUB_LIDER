{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lider.local/portal-fornecedor/schemas/common.schema.json",
  "title": "Portal Fornecedor — tipos comuns",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "isoDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "money": {
      "type": "string",
      "pattern": "^-?\\d+\\.\\d{2}$",
      "description": "Decimal monetário como string com 2 casas (BRL)."
    },
    "cnpj": {
      "type": "string",
      "pattern": "^\\d{14}$",
      "description": "CNPJ somente dígitos."
    },
    "homologationStatus": {
      "type": "string",
      "enum": ["candidato", "aguarda_aceite", "restrito", "bloqueado"]
    },
    "dataFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceUpdatedAt", "syncedAt", "ageSeconds", "slaLabel", "slaBreached"],
      "properties": {
        "sourceUpdatedAt": { "$ref": "#/$defs/isoDateTime" },
        "syncedAt": { "$ref": "#/$defs/isoDateTime" },
        "ageSeconds": { "type": "integer", "minimum": 0 },
        "slaLabel": { "type": "string", "minLength": 1 },
        "slaBreached": { "type": "boolean" }
      }
    },
    "pageMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "hasMore"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
        "hasMore": { "type": "boolean" },
        "nextCursor": { "type": ["string", "null"] },
        "page": { "type": "integer", "minimum": 1 },
        "totalEstimate": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "apiError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "message"],
      "properties": {
        "error": {
          "type": "string",
          "enum": [
            "unauthorized",
            "forbidden",
            "not_found",
            "validation_error",
            "rate_limited",
            "quote_expired",
            "conflict",
            "not_eligible",
            "service_unavailable"
          ]
        },
        "message": { "type": "string" },
        "details": { "type": "array", "items": { "type": "object" } },
        "requestId": { "type": "string" }
      }
    }
  }
}
