{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lider.local/portal-fornecedor/schemas/anticipation-request.schema.json",
  "title": "Anticipation request (create/list/detail)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "quoteId",
    "supplierId",
    "status",
    "createdAt",
    "homologationStatus",
    "currency",
    "totals",
    "lines",
    "writesToErp"
  ],
  "properties": {
    "requestId": { "type": "string", "format": "uuid" },
    "quoteId": { "type": "string", "format": "uuid" },
    "supplierId": { "type": "string", "format": "uuid" },
    "clientRequestId": { "type": "string", "minLength": 8, "maxLength": 64 },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "cotado",
        "solicitado",
        "em_analise",
        "aprovado",
        "recusado",
        "cancelado",
        "expirado",
        "liquidado_parcial",
        "liquidado"
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "homologationStatus": {
      "type": "string",
      "enum": ["candidato", "aguarda_aceite", "restrito", "bloqueado"]
    },
    "acceptTermsVersion": { "type": "string" },
    "currency": { "type": "string", "const": "BRL" },
    "totals": {
      "type": "object",
      "required": ["gross", "discount", "net", "titleCount"],
      "properties": {
        "gross": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" },
        "discount": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" },
        "net": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" },
        "titleCount": { "type": "integer", "minimum": 1 }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["titleId", "amountOpen", "discount", "net"],
        "properties": {
          "titleId": { "type": "string", "format": "uuid" },
          "documentNumber": { "type": "string" },
          "amountOpen": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" },
          "discount": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" },
          "net": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" }
        }
      }
    },
    "writesToErp": {
      "type": "boolean",
      "const": false,
      "description": "Pedido fica no portal; liquidação ERP é processo externo."
    }
  }
}
