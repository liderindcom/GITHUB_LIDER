{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lider.local/portal-fornecedor/schemas/purchase-order.schema.json",
  "title": "Portal Fornecedor - pedidos de compra",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAt", "homologationStatus", "supplierId", "page", "rows"],
  "properties": {
    "generatedAt": { "$ref": "common.schema.json#/$defs/isoDateTime" },
    "homologationStatus": { "$ref": "common.schema.json#/$defs/homologationStatus" },
    "supplierId": { "$ref": "common.schema.json#/$defs/uuid" },
    "dataFreshness": { "$ref": "common.schema.json#/$defs/dataFreshness" },
    "page": { "$ref": "common.schema.json#/$defs/pageMeta" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "orderId",
          "orderNumber",
          "orderKind",
          "originName",
          "destinationName",
          "referenceBranchId",
          "issueDate",
          "expectedDeliveryDate",
          "status",
          "agendaContext",
          "agendaCode",
          "agendaParity",
          "qtyOrderedTotal",
          "qtyInvoicedTotal",
          "fillRatePct",
          "writesToErp",
          "lines"
        ],
        "properties": {
          "orderId": { "$ref": "common.schema.json#/$defs/uuid" },
          "orderNumber": { "type": "string", "minLength": 1 },
          "orderKind": {
            "type": "string",
            "enum": ["supplier_direct", "cdam_central_depot"]
          },
          "originName": { "type": "string", "minLength": 1 },
          "destinationName": { "type": "string", "minLength": 1 },
          "referenceBranchId": { "type": "string", "minLength": 1 },
          "issueDate": { "$ref": "common.schema.json#/$defs/isoDate" },
          "expectedDeliveryDate": { "$ref": "common.schema.json#/$defs/isoDate" },
          "cdamEntryDate": { "$ref": "common.schema.json#/$defs/isoDate" },
          "deliveryLeadTimeDays": { "type": "integer", "minimum": 0 },
          "status": {
            "type": "string",
            "enum": ["aberto", "faturado", "pendente", "entregue", "cancelado"]
          },
          "agendaContext": {
            "type": "string",
            "enum": ["compras_recebimento", "transferencia_cdam"]
          },
          "agendaCode": { "type": "string", "minLength": 1 },
          "agendaParity": { "type": "string", "minLength": 1 },
          "qtyOrderedTotal": { "type": "number", "minimum": 0 },
          "qtyInvoicedTotal": { "type": "number", "minimum": 0 },
          "fillRatePct": { "type": "number", "minimum": 0, "maximum": 100 },
          "ruleSummary": { "type": "string" },
          "writesToErp": { "const": false },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sku",
                "description",
                "qtyOrdered",
                "qtyInvoiced",
                "fillRatePct",
                "unitPrice"
              ],
              "properties": {
                "sku": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "qtyOrdered": { "type": "number", "minimum": 0 },
                "qtyInvoiced": { "type": "number", "minimum": 0 },
                "fillRatePct": { "type": "number", "minimum": 0, "maximum": 100 },
                "unitPrice": { "$ref": "common.schema.json#/$defs/money" }
              }
            }
          }
        }
      }
    }
  }
}
