{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lider.local/portal-fornecedor/schemas/receivable-title.schema.json",
  "title": "GET /v1/receivables/titles",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAt", "homologationStatus", "supplierId", "page", "rows"],
  "properties": {
    "generatedAt": { "type": "string", "format": "date-time" },
    "homologationStatus": {
      "type": "string",
      "enum": ["candidato", "aguarda_aceite", "restrito", "bloqueado"]
    },
    "supplierId": { "type": "string", "format": "uuid" },
    "page": {
      "type": "object",
      "required": ["limit", "hasMore"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
        "hasMore": { "type": "boolean" },
        "nextCursor": { "type": ["string", "null"] }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "titleId",
          "documentNumber",
          "issueDate",
          "dueDate",
          "currency",
          "amountOriginal",
          "amountOpen",
          "status",
          "anticipationEligible",
          "writesToErp"
        ],
        "properties": {
          "titleId": { "type": "string", "format": "uuid" },
          "documentNumber": { "type": "string" },
          "issueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "dueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "currency": { "type": "string", "const": "BRL" },
          "amountOriginal": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" },
          "amountOpen": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" },
          "status": {
            "type": "string",
            "enum": ["aberto", "parcialmente_pago", "liquidado", "cancelado", "em_antecipacao"]
          },
          "anticipationEligible": { "type": "boolean" },
          "ineligibilityReason": {
            "type": ["string", "null"],
            "enum": [
              null,
              "ELG-02",
              "ELG-03",
              "ELG-04",
              "ELG-05",
              "ELG-06",
              "ELG-07",
              "ELG-08",
              "ELG-09",
              "ELG-10"
            ]
          },
          "writesToErp": { "type": "boolean", "const": false }
        }
      }
    }
  }
}
